# Copy to .env and fill in your own values:  cp .env.example .env
# Real .env files are gitignored and must never be committed.
# Retrieval works without a key; the key is only needed for "Retrieve & answer".

GROQ_API_KEY=your-groq-api-key
# Optional - defaults shown
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional - folder of .md/.txt files to explore (defaults to ./data)
# DATA_DIR=/path/to/other/docs
# PORT=8001
